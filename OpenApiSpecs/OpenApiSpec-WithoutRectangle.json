{
  "openapi": "3.1.1",
  "info": {
    "title": "Polymorph REST API",
    "description": "REST API for Polymorph shapes.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://localhost:7299/"
    }
  ],
  "paths": {
    "/shapes": {
      "get": {
        "tags": [
          "PolymorphRestApi.ShapeApi"
        ],
        "summary": "Get sample shapes",
        "description": "Returns one circle and one rectangle.",
        "operationId": "GetShapes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShapeBase"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Point": {
        "type": "object",
        "properties": {
          "x": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "y": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ShapeBase": {
        "required": [
          "$type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ShapeBaseShapeBase"
          },
          {
            "$ref": "#/components/schemas/ShapeBaseCircle"
          },
          {
            "$ref": "#/components/schemas/ShapeBaseRectangle"
          }
        ],
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "Base": "#/components/schemas/ShapeBaseShapeBase",
            "Circle": "#/components/schemas/ShapeBaseCircle",
            "Rectangle": "#/components/schemas/ShapeBaseRectangle"
          }
        }
      },
      "ShapeBaseCircle": {
        "required": [
          "center",
          "radius",
          "name"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Circle"
            ],
            "type": "string"
          },
          "center": {
            "$ref": "#/components/schemas/Point"
          },
          "radius": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ShapeBaseRectangle": {
        "required": [
          "topLeft",
          "width",
          "height",
          "name"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Rectangle"
            ],
            "type": "string"
          },
          "topLeft": {
            "$ref": "#/components/schemas/Point"
          },
          "width": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ShapeBaseShapeBase": {
        "required": [
          "name"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Base"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "PolymorphRestApi.ShapeApi"
    }
  ]
}