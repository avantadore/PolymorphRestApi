{
  "openapi": "3.1.1",
  "info": {
    "title": "Polymorph REST API",
    "description": "REST API for Polymorph shapes.",
    "version": "v1"
  },
  "paths": {
    "/shapes": {
      "get": {
        "tags": [
          "PolymorphRestApi.ShapeApi"
        ],
        "summary": "Get sample shapes",
        "description": "Returns one circle and one rectangle.",
        "operationId": "GetShapes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShapeBase"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Point": {
        "type": "object",
        "properties": {
          "x": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "y": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ShapeBase": {
        "required": [
          "name"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ShapeBaseCircle"
          },
          {
            "$ref": "#/components/schemas/ShapeBaseRectangle"
          },
          {
            "$ref": "#/components/schemas/ShapeBaseTriangle"
          },
          {
            "$ref": "#/components/schemas/ShapeBaseBase"
          }
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "Circle": "#/components/schemas/ShapeBaseCircle",
            "Rectangle": "#/components/schemas/ShapeBaseRectangle",
            "Triangle": "#/components/schemas/ShapeBaseTriangle"
          }
        }
      },
      "ShapeBaseBase": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ShapeBaseCircle": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ShapeBase"
          },
          {
            "required": [
              "$type",
              "center",
              "radius"
            ],
            "properties": {
              "$type": {
                "enum": [
                  "Circle"
                ],
                "type": "string"
              },
              "center": {
                "$ref": "#/components/schemas/Point"
              },
              "radius": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": [
                  "integer",
                  "string"
                ],
                "format": "int32"
              }
            }
          }
        ]
      },
      "ShapeBaseRectangle": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ShapeBase"
          },
          {
            "required": [
              "$type",
              "topLeft",
              "width",
              "height"
            ],
            "properties": {
              "$type": {
                "enum": [
                  "Rectangle"
                ],
                "type": "string"
              },
              "topLeft": {
                "$ref": "#/components/schemas/Point"
              },
              "width": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": [
                  "integer",
                  "string"
                ],
                "format": "int32"
              },
              "height": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": [
                  "integer",
                  "string"
                ],
                "format": "int32"
              }
            }
          }
        ]
      },
      "ShapeBaseTriangle": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ShapeBase"
          },
          {
            "required": [
              "$type",
              "vertex1",
              "vertex2",
              "vertex3"
            ],
            "properties": {
              "$type": {
                "enum": [
                  "Triangle"
                ],
                "type": "string"
              },
              "vertex1": {
                "$ref": "#/components/schemas/Point"
              },
              "vertex2": {
                "$ref": "#/components/schemas/Point"
              },
              "vertex3": {
                "$ref": "#/components/schemas/Point"
              }
            }
          }
        ]
      }
    }
  },
  "tags": [
    {
      "name": "PolymorphRestApi.ShapeApi"
    }
  ]
}